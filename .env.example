# This file contains configuration examples only. Never put AWS access keys here.
AWS_PROFILE=default
AWS_REGION=us-east-1
STAGE=dev

# Safety guard. Required by deployment scripts for staging and production.
# Set it to the 12-digit destination AWS account; it is an identifier, not a secret.
EXPECTED_AWS_ACCOUNT_ID=

# Optional: AWS Academy/Learner Lab role reused by Lambdas and web deployment.
# API Gateway execution logs are disabled and dev buckets retained in this mode.
LAB_ROLE_ARN=

# If your lab only provides short-lived keys, put them in .env.local (never commit it):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Used by the optional Python bulk ingestion. Copy to .env.local and change it.
INGESTION_DEFAULT_PASSWORD=ChangeMe-123456!
INGESTION_TENANTS=udemy,cursarplus
